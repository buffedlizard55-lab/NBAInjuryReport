# Copy to .env only on the host. Do not commit secrets.
# Without these, the process uses a local JSON file (db/file-store.js).

SUPABASE_URL=
SUPABASE_KEY=

# Render sets PORT. Local default is 8787.
PORT=8787
HOST=0.0.0.0

# 0 = injury collectors run only while ESPN scoreboard state is "in"
# (the brief). Set 6–12 to also poll the hours before kickoff. Posts older
# than 30 minutes are still discarded, so this does not replay Friday news
# on Sunday.
GAME_WINDOW_HOURS=0
